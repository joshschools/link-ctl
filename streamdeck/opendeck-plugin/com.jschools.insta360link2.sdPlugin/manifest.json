{
  "Name": "Insta360 Link 2",
  "Description": "Control Insta360 Link 2 on Linux via link-ctl (USB). No Windows Insta360 app required.",
  "Author": "jschools",
  "Version": "0.2.0",
  "Icon": "icons/plugin",
  "Category": "Camera",
  "CategoryIcon": "icons/plugin",
  "CodePathLin": "index.js",
  "OS": [
    {
      "Platform": "linux",
      "MinimumVersion": "5.0"
    }
  ],
  "Software": {
    "MinimumVersion": "2.5"
  },
  "SDKVersion": 2,
  "Actions": [
    {
      "UUID": "com.jschools.insta360link2.track",
      "Name": "AI Tracking",
      "Icon": "icons/track-on",
      "Tooltip": "Toggle AI subject tracking",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/track-off", "Name": "Off" },
        { "Image": "icons/track-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.deskview",
      "Name": "DeskView",
      "Icon": "icons/desk-on",
      "Tooltip": "Toggle DeskView (desk surface)",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/desk-off", "Name": "Off" },
        { "Image": "icons/desk-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.overhead",
      "Name": "Overhead",
      "Icon": "icons/overhead-on",
      "Tooltip": "Toggle overhead / top-down view",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/overhead-off", "Name": "Off" },
        { "Image": "icons/overhead-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.mirror",
      "Name": "Mirror",
      "Icon": "icons/mirror-on",
      "Tooltip": "Toggle horizontal mirror / flip",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/mirror-off", "Name": "Off" },
        { "Image": "icons/mirror-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.whiteboard",
      "Name": "Whiteboard",
      "Icon": "icons/board-on",
      "Tooltip": "Toggle whiteboard mode",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/board-off", "Name": "Off" },
        { "Image": "icons/board-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.privacy",
      "Name": "Privacy",
      "Icon": "icons/privacy-on",
      "Tooltip": "Toggle gimbal-down privacy (Link 2)",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/privacy-off", "Name": "Off" },
        { "Image": "icons/privacy-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.hdr",
      "Name": "HDR",
      "Icon": "icons/hdr-on",
      "Tooltip": "Toggle HDR",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [
        { "Image": "icons/hdr-off", "Name": "Off" },
        { "Image": "icons/hdr-on", "Name": "On" }
      ]
    },
    {
      "UUID": "com.jschools.insta360link2.center",
      "Name": "Center",
      "Icon": "icons/center",
      "Tooltip": "Center pan/tilt and reset zoom",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "icons/center", "Name": "Center" }]
    },
    {
      "UUID": "com.jschools.insta360link2.reset",
      "Name": "Reset Camera",
      "Icon": "icons/reset",
      "Tooltip": "Recover hung Link 2 USB and return to normal mode",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "icons/reset", "Name": "Reset" }]
    },
    {
      "UUID": "com.jschools.insta360link2.normal",
      "Name": "Normal Mode",
      "Icon": "icons/normal",
      "Tooltip": "Return to standard video mode",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "icons/normal", "Name": "Normal" }]
    },
    {
      "UUID": "com.jschools.insta360link2.zoomin",
      "Name": "Zoom In",
      "Icon": "icons/zoom-in",
      "Tooltip": "Zoom in (+50)",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "icons/zoom-in", "Name": "Zoom +" }]
    },
    {
      "UUID": "com.jschools.insta360link2.zoomout",
      "Name": "Zoom Out",
      "Icon": "icons/zoom-out",
      "Tooltip": "Zoom out (−50)",
      "Controllers": ["Keypad", "Encoder"],
      "SupportedInMultiActions": true,
      "States": [{ "Image": "icons/zoom-out", "Name": "Zoom −" }]
    }
  ]
}
